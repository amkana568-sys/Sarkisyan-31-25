from __future__ import annotations

import tkinter as tk
from tkinter import scrolledtext

from .config import AppConfig, config_debug
from .shell import Shell
from .vfs import VFS


class EmulatorApp:
    def __init__(self, root: tk.Tk, cfg: AppConfig, vfs: VFS):
        self.root = root
        self.cfg = cfg
        self.vfs = vfs
        self.shell = Shell(vfs, cfg.prompt)

        # Заголовок окна содержит имя VFS.
        root.title(f"Эмулятор — {vfs.name}")
        root.geometry("900x600")

        self.output = scrolledtext.ScrolledText(root, wrap=tk.WORD)
        self.output.pack(fill=tk.BOTH, expand=True, padx=8, pady=8)

        bottom = tk.Frame(root)
        bottom.pack(fill=tk.X, padx=8, pady=(0, 8))

        # Пользовательское приглашение отображается в REPL.
        self.prompt_label = tk.Label(bottom, text=cfg.prompt)
        self.prompt_label.pack(side=tk.LEFT)

        self.entry = tk.Entry(bottom)
        self.entry.pack(side=tk.LEFT, fill=tk.X, expand=True)
        self.entry.bind("<Return>", self.on_enter)
        self.entry.focus_set()

        # Отладочный вывод всех параметров при запуске.
        self.append(config_debug(cfg))
        self.append(f"VFS загружена: {vfs.name}")

        self.run_startup_script()

    def append(self, text: str) -> None:
        self.output.insert(tk.END, text + "\n")
        self.output.see(tk.END)

    def on_enter(self, event=None) -> None:
        line = self.entry.get()
        self.entry.delete(0, tk.END)

        self.append(f"{self.cfg.prompt}{line}")
        result = self.shell.execute(line)

        if result.output:
            self.append(result.output)

        if result.exit_requested:
            self.root.after(50, self.root.destroy)

    def run_startup_script(self) -> None:
        if not self.cfg.startup_path:
            return

        self.append(f"=== Стартовый скрипт: {self.cfg.startup_path} ===")

        try:
            with open(self.cfg.startup_path, "r", encoding="utf-8") as f:
                lines = f.read().splitlines()
        except OSError as e:
            self.append(
                f"[script error] не удалось прочитать стартовый скрипт: {e}"
            )
            return

        for number, raw in enumerate(lines, start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue

            self.append(f"{self.cfg.prompt}{line}")
            result = self.shell.execute(line)

            if result.output:
                self.append(result.output)

            # Ошибочные строки пропускаем, но сообщаем об ошибке.
            if not result.ok:
                self.append(
                    f"[script error] строка {number}: команда завершилась с ошибкой"
                )

            if result.exit_requested:
                self.root.after(50, self.root.destroy)
                break









from __future__ import annotations

from dataclasses import dataclass
from typing import List

from .vfs import VFS


@dataclass
class CommandResult:
    output: str = ""
    ok: bool = True
    exit_requested: bool = False


class Shell:
    def __init__(self, vfs: VFS, prompt: str = "vfs> "):
        self.vfs = vfs
        self.prompt = prompt
        self.history: List[str] = []

    def execute(self, line: str) -> CommandResult:
        line = line.strip()
        if not line:
            return CommandResult()

        self.history.append(line)

        # Простой парсер: разделение ввода на команду и аргументы по пробелам.
        parts = line.split()
        cmd, args = parts[0], parts[1:]

        if cmd == "exit":
            if args:
                return CommandResult("Ошибка: exit: неверные аргументы", ok=False)
            return CommandResult(exit_requested=True)

        if cmd == "ls":
            # Заглушка этапа 1-3.
            return CommandResult(f"ls: args={args!r}")

        if cmd == "cd":
            # Заглушка этапа 1-3, но с проверкой аргументов.
            if len(args) != 1:
                return CommandResult(
                    "Ошибка: cd: требуется ровно один аргумент",
                    ok=False,
                )
            return CommandResult(f"cd: args={args!r}")

        return CommandResult(f"Ошибка: неизвестная команда: {cmd}", ok=False)








#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$ROOT/build"
VFS="$ROOT/examples/vfs"

mkdir -p "$BUILD" "$VFS"

rm -rf "$BUILD/vfs_min" "$BUILD/vfs_many" "$BUILD/vfs_deep"

# Минимальная VFS.
mkdir -p "$BUILD/vfs_min"
echo "minimal vfs" > "$BUILD/vfs_min/readme.txt"
(cd "$BUILD/vfs_min" && zip -qr "$VFS/vfs_min.zip" .)

# Несколько файлов.
mkdir -p "$BUILD/vfs_many/docs"
echo "hello" > "$BUILD/vfs_many/readme.txt"
echo "doc1" > "$BUILD/vfs_many/docs/a.txt"
echo "doc2" > "$BUILD/vfs_many/docs/b.txt"
(cd "$BUILD/vfs_many" && zip -qr "$VFS/vfs_many.zip" .)

# Не менее 3 уровней папок.
mkdir -p "$BUILD/vfs_deep/a/b/c"
echo "deep" > "$BUILD/vfs_deep/a/b/c/file.txt"
echo "root" > "$BUILD/vfs_deep/root.txt"
(cd "$BUILD/vfs_deep" && zip -qr "$VFS/vfs_deep.zip" .)

echo "OK: созданы $VFS/vfs_min.zip, $VFS/vfs_many.zip, $VFS/vfs_deep.zip"

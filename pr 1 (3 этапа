import unittest

from src.shell import Shell
from src.vfs import default_vfs


class TestShell(unittest.TestCase):
    def setUp(self):
        self.shell = Shell(default_vfs("test"))

    def test_ls_stub(self):
        result = self.shell.execute("ls -la")
        self.assertTrue(result.ok)
        self.assertIn("ls", result.output)
        self.assertIn("-la", result.output)

    def test_cd_requires_one_arg(self):
        result = self.shell.execute("cd")
        self.assertFalse(result.ok)
        self.assertIn("cd", result.output)

    def test_unknown_command(self):
        result = self.shell.execute("unknown")
        self.assertFalse(result.ok)
        self.assertIn("неизвестная", result.output)

    def test_exit(self):
        result = self.shell.execute("exit")
        self.assertTrue(result.exit_requested)


if __name__ == "__main__":
    unittest.main()










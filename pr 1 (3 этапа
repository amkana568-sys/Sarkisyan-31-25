from __future__ import annotations

import os
import zipfile
from dataclasses import dataclass, field
from typing import Dict, Optional


class VFSError(Exception):
    pass


@dataclass
class Node:
    name: str
    is_dir: bool
    data: bytes = b""
    children: Dict[str, "Node"] = field(default_factory=dict)


class VFS:
    def __init__(self, name: str, root: Node):
        self.name = name
        self.root = root


def default_vfs(name: str = "default") -> VFS:
    root = Node("/", True)
    root.children["readme.txt"] = Node(
        "readme.txt", False, b"Default in-memory VFS\n"
    )
    return VFS(name, root)


def load_vfs_zip(path: Optional[str]) -> VFS:
    if not path:
        return default_vfs()

    if not os.path.exists(path):
        raise VFSError(f"VFS ZIP не найден: {path}")

    if not zipfile.is_zipfile(path):
        raise VFSError(f"VFS не является ZIP-архивом: {path}")

    root = Node("/", True)

    try:
        with zipfile.ZipFile(path, "r") as zf:
            for info in zf.infolist():
                parts = [p for p in info.filename.replace("\\", "/").split("/") if p]
                if not parts:
                    continue

                current = root
                for part in parts[:-1]:
                    if part not in current.children:
                        current.children[part] = Node(part, True)
                    current = current.children[part]
                    if not current.is_dir:
                        raise VFSError(
                            f"Конфликт файла и папки в VFS: {info.filename}"
                        )

                last = parts[-1]
                if info.is_dir():
                    if last not in current.children:
                        current.children[last] = Node(last, True)
                else:
                    # Бинарные данные храним в памяти как bytes.
                    current.children[last] = Node(last, False, zf.read(info))
    except zipfile.BadZipFile as e:
        raise VFSError(f"Ошибка чтения ZIP-архива: {e}") from e

    return VFS(os.path.basename(path), root)















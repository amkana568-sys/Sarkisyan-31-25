import os
import tempfile
import unittest
import zipfile

from src.vfs import VFSError, load_vfs_zip


class TestVFS(unittest.TestCase):
    def test_load_zip(self):
        with tempfile.TemporaryDirectory() as d:
            zip_path = os.path.join(d, "vfs.zip")
            with zipfile.ZipFile(zip_path, "w") as zf:
                zf.writestr("readme.txt", "hello")
                zf.writestr("docs/a.txt", "a")

            vfs = load_vfs_zip(zip_path)
            self.assertIn("readme.txt", vfs.root.children)
            self.assertIn("docs", vfs.root.children)
            self.assertTrue(vfs.root.children["docs"].is_dir)

    def test_invalid_zip(self):
        with tempfile.TemporaryDirectory() as d:
            bad = os.path.join(d, "bad.zip")
            with open(bad, "w", encoding="utf-8") as f:
                f.write("not a zip")
            with self.assertRaises(VFSError):
                load_vfs_zip(bad)


if __name__ == "__main__":
    unittest.main()







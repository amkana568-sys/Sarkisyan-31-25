from __future__ import annotations

import argparse
import os
import xml.etree.ElementTree as ET
from dataclasses import dataclass
from typing import Any, Dict, Optional


class ConfigError(Exception):
    pass


@dataclass
class AppConfig:
    vfs_path: Optional[str] = None
    prompt: str = "vfs> "
    startup_path: Optional[str] = None
    config_path: Optional[str] = None


def _xml_value(root: ET.Element, tag: str, attr: Optional[str] = None) -> Optional[str]:
    el = root.find(tag)
    if el is None:
        return None
    if attr:
        value = el.get(attr)
        if value is not None:
            return value
    text = (el.text or "").strip()
    return text or None


def _read_xml(path: str) -> Dict[str, Any]:
    try:
        tree = ET.parse(path)
    except Exception as e:
        raise ConfigError(f"Не удалось прочитать XML-конфигурацию '{path}': {e}") from e

    root = tree.getroot()
    data: Dict[str, Any] = {
        "vfs_path": _xml_value(root, "vfs", "path"),
        "prompt": _xml_value(root, "prompt"),
        "startup_path": _xml_value(root, "startup", "path")
        or _xml_value(root, "script", "path"),
    }

    # Поддержка варианта <config vfs="..." prompt="..." startup="...">
    if not data.get("vfs_path") and root.get("vfs"):
        data["vfs_path"] = root.get("vfs")
    if not data.get("prompt") and root.get("prompt"):
        data["prompt"] = root.get("prompt")
    if not data.get("startup_path") and root.get("startup"):
        data["startup_path"] = root.get("startup")

    return {k: v for k, v in data.items() if v is not None}


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description="Эмулятор shell, вариант 23, этапы 1-3"
    )
    parser.add_argument("--vfs", dest="vfs_path", help="Путь к ZIP-архиву VFS")
    parser.add_argument("--prompt", dest="prompt", help="Пользовательское приглашение REPL")
    parser.add_argument("--script", dest="startup_path", help="Путь к стартовому скрипту")
    parser.add_argument("--config", dest="config_path", help="Путь к XML-конфигурации")
    return parser.parse_args(argv)


def load_config(argv=None) -> AppConfig:
    args = parse_args(argv)
    file_data = _read_xml(args.config_path) if args.config_path else {}

    cfg = AppConfig(config_path=args.config_path)

    # Приоритет: командная строка > XML-файл > значение по умолчанию.
    cfg.vfs_path = args.vfs_path if args.vfs_path is not None else file_data.get("vfs_path")
    cfg.prompt = args.prompt if args.prompt is not None else file_data.get("prompt", "vfs> ")
    cfg.startup_path = (
        args.startup_path
        if args.startup_path is not None
        else file_data.get("startup_path")
    )

    if not cfg.prompt:
        cfg.prompt = "vfs> "

    return cfg


def config_debug(cfg: AppConfig) -> str:
    lines = [
        "=== Параметры эмулятора ===",
        f"config_path = {cfg.config_path!r}",
        f"vfs_path    = {cfg.vfs_path!r}",
        f"prompt      = {cfg.prompt!r}",
        f"startup     = {cfg.startup_path!r}",
    ]
    if cfg.vfs_path:
        lines.append(f"vfs_abs     = {os.path.abspath(cfg.vfs_path)!r}")
    if cfg.startup_path:
        lines.append(f"startup_abs = {os.path.abspath(cfg.startup_path)!r}")
    return "\n".join(lines)












